        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="Office" Type="string" Value="Software\Office\Capabilities" />

        <!-- The "Open with" list for the executable. App Paths alone only covers Win+R and
             ShellExecute; this is what puts the suite in the Open with menu. -->
