<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Office" Manufacturer="Iridium Technologies, Inc." Version="$(var.Version)" UpgradeCode="B4E9C2A1-7D63-5F08-9C14-2E8A6D5F30B7" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Office suite" Manufacturer="Iridium Technologies, Inc." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3).
         The removal is scheduled late, so an upgrade does not unpin the taskbar icon. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of Office is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="OfficeIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="OfficeIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://iridium.ph" />
    <Property Id="ARPURLUPDATEINFO" Value="https://iridium.ph" />
    <Property Id="ARPHELPLINK" Value="https://iridium.ph" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Iridium">
        <Directory Id="INSTALLFOLDER" Name="Office" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Office" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="OfficeFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>

    <!-- The Start menu shortcut lives in its own component with an HKCU key path: a Shortcut
         inside a File element trips ICE43/ICE57 in a package that can install per user or per
         machine. -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="8B4F1D6C-2E73-4A9B-9C05-7D1E6F38A204">
      <Shortcut Id="StartMenuShortcut" Name="Office" Description="Office suite"
                Target="[#OfficeExe]" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
      <RegistryValue Root="HKCU" Key="Software\Office" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <ComponentGroup Id="OfficeFiles" Directory="INSTALLFOLDER">
      <Component Id="OfficeApp" Guid="2C7B4F19-5E8A-4D31-B6C9-0F3A8D2E5741">
        <File Id="OfficeNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="OfficeExe" Source="$(var.BinDir)\iridium-office.exe" KeyPath="yes">
          <!-- No Icon here, so the shortcut shows the icon embedded in iridium-office.exe (build.rs).
               An MSI Icon is cached under %APPDATA%\Microsoft\Installer\{ProductCode}\, and every
               update is a major upgrade with a new ProductCode that deletes the old folder. A
               taskbar pin is a copy of this shortcut that the update never touches, so it kept
               pointing at the deleted file and lost its icon. The exe's path survives updates; the
               shortcut is not advertised, so it targets that path and its icon is the exe's own.
               The Icon above stays for ARPPRODUCTICON (Apps and features). -->
        </File>

        <!-- The suite routes every format to the module that owns it, so it offers the union of
             the five apps' extensions.

             The suite's own format is registered as an Extension, so it is the default handler
             for it. Every other type is only OFFERED: an Extension for a foreign type writes
             HKCR\.pdf\(Default), which takes the file type over from whatever the user already
             had and, on uninstall, breaks their association. The rows below put each type in
             "Open with" and in the default apps settings, where the choice stays the user's.

             WiX v5 derives a registry identifier from the content type, so two Extension
             elements with the same ContentType under one ProgId collide. The raw registry rows
             have distinct keys, so they do not. -->
        <ProgId Id="Office.Deck" Description="Office Presentation">
          <Extension Id="iridium-decks" ContentType="application/x-iridium-decks">
            <Verb Id="open" Command="Open" TargetFile="OfficeExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <ProgId Id="Office.Photos" Description="Workspace Photos" />
        <ProgId Id="Office.Film" Description="Workspace Film" />
        <ProgId Id="Office.Light" Description="Workspace Light" />

        <RegistryKey Root="HKCR" Key="Office.Message">
          <RegistryValue Type="string" Value="Office Mail Message" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#OfficeExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#OfficeExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Office.Mailbox">
          <RegistryValue Type="string" Value="Office Mailbox" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#OfficeExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#OfficeExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Office.Calendar">
          <RegistryValue Type="string" Value="Office Calendar" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#OfficeExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#OfficeExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Office.Contact">
          <RegistryValue Type="string" Value="Office Contact" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#OfficeExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#OfficeExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Office.OutlookMessage">
          <RegistryValue Type="string" Value="Office Outlook Message" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#OfficeExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#OfficeExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Office.OutlookDataFile">
          <RegistryValue Type="string" Value="Office Outlook Data File" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#OfficeExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#OfficeExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Office.BinarySpreadsheet">
          <RegistryValue Type="string" Value="Office Spreadsheet" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#OfficeExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#OfficeExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="Office.Csv">
